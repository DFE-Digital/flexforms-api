<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Version>1.0.0</Version>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageId>GovUK.Dfe.FlexForms.Api.Client</PackageId>
		<Title>FlexForms API Client (NSwag HTTP SDK)</Title>
		<Description>First-party .NET HTTP client for the FlexForms API (GovUK.Dfe.FlexForms.Api). Includes NSwag-generated typed clients and DTOs for applications, templates, users, roles, tenant admin, files, notifications, and token exchange, plus ASP.NET Core handlers for DfE Sign-In / Entra token exchange, Azure bearer tokens, header forwarding (tenant, template, application), and DI registration. Targets net8.0 and net10.0. Intended for FlexForms Web and other first-party hosts — not a substitute for a narrow integration HttpClient with API-key auth.</Description>
		<PackageTags>dfe;govuk;flexforms;api-client;nswag;http;oidc;token-exchange;multitenant</PackageTags>
		<Authors>DFE-Digital</Authors>
		<TargetFramework></TargetFramework>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="GovUK.Dfe.CoreLibs.Contracts" Version="1.0.101" />
		<PackageReference Include="GovUK.Dfe.CoreLibs.Http" Version="1.0.12" />
		<PackageReference Include="GovUK.Dfe.CoreLibs.Security" Version="1.1.30" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.14" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.3" />
	</ItemGroup>

</Project>
