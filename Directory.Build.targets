<Project>
	<!-- Direct references are stamped at evaluation (packing builds them outside the target below), NuGet-transitive ones
	     in the target, so every build of the local Contracts project shares the same global properties (one output, no
	     concurrent writes) and carries LocalCoreLibsVersion. -->
	<ItemGroup Condition="'$(LocalCoreLibsVersion)' != ''">
		<ProjectReference Update="$(LocalCoreLibsSrc)GovUK.Dfe.CoreLibs.Contracts\GovUK.Dfe.CoreLibs.Contracts.csproj"
		                  AdditionalProperties="Version=$(LocalCoreLibsVersion)" />
	</ItemGroup>

	<Target Name="StampLocalCoreLibsVersion"
	        AfterTargets="IncludeTransitiveProjectReferences"
	        BeforeTargets="AssignProjectConfiguration"
	        Condition="'$(LocalCoreLibsVersion)' != ''">
		<ItemGroup>
			<ProjectReference Condition="'%(Filename)' == 'GovUK.Dfe.CoreLibs.Contracts'">
				<AdditionalProperties>Version=$(LocalCoreLibsVersion)</AdditionalProperties>
			</ProjectReference>
		</ItemGroup>
	</Target>
</Project>
